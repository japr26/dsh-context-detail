{
  "name": "@local/dsh-context-detail",
  "version": "1.10.4",
  "private": true,
  "type": "module",
  "description": "Context strip and context panel with tool, plugin, skill and cache detail.",
  "license": "MIT",
  "author": "japr26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japr26/dsh-context-detail.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "context-window",
    "tokens"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
